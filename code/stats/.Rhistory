library(rlang)
library(BayesFactor)
library(ggplot2)
library(dplyr)
library(emmeans)
library(ARTool)
# Quick script for specific analyses, will be improved later
# Read table
accuracies <- read.csv('../../outputs/derivatives/stats/VBT_data-test_variable-accuracy_table.csv')
